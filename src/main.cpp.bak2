#include <Arduino.h>
#include "Pin.hpp"

namespace {
    constexpr Hardware::Pin vcc_pin(PIN_013);   // white
    constexpr Hardware::Pin spi_sck(PIN_031);   // blue
    constexpr Hardware::Pin latch_pin(PIN_029); // yellow
    constexpr Hardware::Pin spi_miso(PIN_002);  // red
    constexpr Hardware::Pin gnd_pin(PIN_115);   // brown

    constexpr Hardware::Pin spi_mosi(PIN_113);  // unused
}

SoftwareTimer vcc_timer;
SoftwareTimer sck_timer;
SoftwareTimer miso_timer;
SoftwareTimer latc_timer;
SoftwareTimer mosi_timer;
SoftwareTimer gnd_timer;


void setup() {
    vcc_pin.pinMode(OUTPUT);
    spi_sck.pinMode(OUTPUT);
    latch_pin.pinMode(OUTPUT);
    spi_miso.pinMode(OUTPUT);
    gnd_pin.pinMode(OUTPUT);
    spi_mosi.pinMode(OUTPUT);

    vcc_timer.begin(10, [](TimerHandle_t timer){
        vcc_pin.digitalToggle();
    });
    sck_timer.begin(20, [](TimerHandle_t timer){
        spi_sck.digitalToggle();
    });
    latc_timer.begin(30, [](TimerHandle_t timer){
        latch_pin.digitalToggle();
    });
    miso_timer.begin(40, [](TimerHandle_t timer){
        spi_miso.digitalToggle();
    });
    gnd_timer.begin(60, [](TimerHandle_t timer){
        gnd_pin.digitalToggle();
    });
    mosi_timer.begin(50, [](TimerHandle_t timer){
        spi_mosi.digitalToggle();
    });

    vcc_timer.start();
    sck_timer.start();
    latc_timer.start();
    miso_timer.start();
    gnd_timer.start();
    mosi_timer.start();
}

void loop() {
    waitForEvent();
}
